#include "ReflectINI_writer.h"

void printDocument(const char* title, INIwriter &writer) {
  Serial.println(title);
  if(writer.hasError()) {
    Serial.print("Writer error: ");
    Serial.println(writer.getErrorMsg());
  } else {
    Serial.println(writer.getINI());
  }
  Serial.println();
}

void writeDocument(INIwriter &writer) {
  writer.comment("Generated by ReflectINI");
  writer.write(1, "version");
  writer.write("Bike controller", "name");

  writer.startSection("status");
  writer.write(18.6f, "speed");
  writer.write(3, "assist");
  writer.write(true, "light");

  writer.startSection("limits");
  writer.write(25, "speed");
  writer.write(5, "walk");
}

void setup() {
  // Give USB serial enough time to become available after reset.
  Serial.begin(115200);
  delay(1000);

  INIwriter writer(512);

  // Default formatting: spaces around '=' and one blank line before each section.
  writeDocument(writer);
  printDocument("Default formatting:", writer);

  writer.resetINI();

  // Compact formatting keeps exactly the same data model.
  IniConfig compact;
  compact.spaceAroundEquals = false;
  compact.blankLineBeforeSection = false;
  writer.setConfig(compact);

  writeDocument(writer);
  printDocument("Compact formatting:", writer);
}

void loop() {}

